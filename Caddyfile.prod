rmihai.com, www.rmihai.com {
    redir /vehicles* https://vehicles.rmihai.com/
    redir https://github.com/rszabadi
}

vehicles.rmihai.com {
    encode gzip

    @api path /vehicles /vehicles/* /swagger-ui /swagger-ui/* /swagger-ui.html /v3/api-docs /v3/api-docs/* /login /logout
    handle @api {
        reverse_proxy app:8080
    }

    handle {
        header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
        header X-Content-Type-Options "nosniff"
        root * /srv/vehicles
        file_server
    }
}
